generator client {
  provider     = "prisma-client-js"
  output       = "../lib/prisma/_generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  INSTRUCTOR
  STUDENT
  ADMIN
}

enum OtpPurpose {
  SIGN_UP
  RESET_PASSWORD
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum RecordingStatus {
  PROCESSING
  UPLOADING
  UPLOADED
  FAILED
}

enum NotifType {
  MEETING_SCHEDULED
  MEETING_STARTING
  MEETING_CANCELLED
  RECORDING_READY
  GROUP_INVITE
}

model User {
  id                  String       @id @default(cuid())
  name                String
  email               String       @unique
  password            String
  role                Role         @default(STUDENT)
  phone               String?
  dateOfBirth         DateTime?
  avatarUrl           String?
  resetpasswordToken  String?
  resetpasswordExpire DateTime?
  passwordChangedAt   DateTime?
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  active              Boolean      @default(true)
  verificationCode    String?
  otpPurpose          OtpPurpose?
  otpExpire           DateTime?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  sessions            Session[]
  ownedGroups         Group[]      @relation("InstructorGroups")
  enrollments         Enrollment[] @relation("StudentEnrollments")
  meetings            Meeting[]    @relation("InstructorMeetings")
  notifications       Notification[]

  @@index([email])
  @@index([verificationCode, created_at])
}

model Session {
  id           String   @id @default(cuid())
  refreshToken String
  deviceInfo   Json?
  expiresAt    DateTime
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model Group {
  id           String       @id @default(cuid())
  name         String
  description  String?
  subject      String?
  inviteCode   String       @unique
  instructorId String
  instructor   User         @relation("InstructorGroups", fields: [instructorId], references: [id])
  enrollments  Enrollment[]
  meetings     Meeting[]
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  @@index([instructorId])
  @@index([inviteCode])
}

model Enrollment {
  id        String   @id @default(cuid())
  joinedAt  DateTime @default(now())
  studentId String
  student   User     @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([studentId, groupId])
  @@index([groupId])
  @@index([studentId])
}

model Meeting {
  id            String        @id @default(cuid())
  title         String
  description   String?
  scheduledAt   DateTime
  timezone      String        @default("UTC")
  duration      Int
  status        MeetingStatus @default(SCHEDULED)
  roomCode      String        @unique
  isInstant     Boolean       @default(false)
  isGroupLocked Boolean       @default(false)
  instructorId  String
  instructor    User          @relation("InstructorMeetings", fields: [instructorId], references: [id])
  groupId       String?
  group         Group?        @relation(fields: [groupId], references: [id])
  room          Room?
  recording     Recording?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  @@index([instructorId, status])
  @@index([groupId])
  @@index([roomCode])
  @@index([scheduledAt])
}

model Room {
  id              String    @id @default(cuid())
  livekitRoomName String    @unique
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  meetingId       String    @unique
  meeting         Meeting   @relation(fields: [meetingId], references: [id])
}

model Recording {
  id               String          @id @default(cuid())
  status           RecordingStatus @default(PROCESSING)
  r2Key            String?
  driveFileId      String?         @unique
  fileName         String
  driveWebViewLink String?
  duration         Int?
  sizeBytes        BigInt?
  uploadedAt       DateTime        @default(now())
  meetingId        String          @unique
  meeting          Meeting         @relation(fields: [meetingId], references: [id])

  @@index([meetingId])
  @@index([status])
}

model Notification {
  id         String    @id @default(cuid())
  type       NotifType
  title      String
  body       String
  read       Boolean   @default(false)
  metadata   Json?
  created_at DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, created_at])
}