generator client {
  provider     = "prisma-client-js"
  output       = "../lib/prisma/_generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum Role {
  INSTRUCTOR
  STUDENT
  ADMIN
}

enum OtpPurpose {
  SIGN_UP
  RESET_PASSWORD
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum MeetingPlatform {
  NEUROMEET
  ZOOM
  GOOGLE_MEET
}

enum ParticipantRole {
  HOST
  CO_HOST
  PARTICIPANT
  OBSERVER
}

enum RecordingStatus {
  PROCESSING
  UPLOADING
  UPLOADED
  FAILED
}

enum NotifType {
  MEETING_SCHEDULED
  MEETING_STARTING
  MEETING_CANCELLED
  RECORDING_READY
  GROUP_INVITE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// =========================
// MODELS
// =========================

model User {
  id                  String       @id @default(cuid())
  name                String
  email               String       @unique
  password            String
  role                Role         @default(STUDENT)
  phone               String?
  dateOfBirth         DateTime?
  avatarUrl           String?
  isProfileComplete   Boolean      @default(false)
  refreshToken        String?
  resetpasswordToken  String?
  resetpasswordExpire DateTime?
  passwordChangedAt   DateTime?
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  active              Boolean      @default(true)
  verificationCode    String?
  otpPurpose          OtpPurpose?
  otpExpire           DateTime?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  // Old Relations
  hostedMeetings      Meeting[]            @relation("MeetingHost")
  meetingParticipants MeetingParticipant[]
  uploadedMaterials   MeetingMaterial[]

  // New Relations
  sessions            Session[]
  ownedGroups         Group[]      @relation("InstructorGroups")
  enrollments         Enrollment[] @relation("StudentEnrollments")
  invitations         Invitation[] @relation("StudentInvitations")
  notifications       Notification[]

  @@index([email])
  @@index([verificationCode, created_at])
}

model Session {
  id           String   @id @default(cuid())
  refreshToken String
  deviceInfo   Json?
  expiresAt    DateTime
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([userId, createdAt])
}

model Group {
  id           String       @id @default(cuid())
  name         String
  description  String?
  subject      String?
  instructorId String
  instructor   User         @relation("InstructorGroups", fields: [instructorId], references: [id])
  enrollments  Enrollment[]
  invitations  Invitation[]
  meetings     Meeting[]
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  
  @@index([instructorId])
}

model Enrollment {
  id        String   @id @default(cuid())
  joinedAt  DateTime @default(now())
  studentId String
  student   User     @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  @@unique([studentId, groupId])
  @@index([groupId])
  @@index([studentId])
}

model Invitation {
  id        String           @id @default(cuid())
  groupId   String
  group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   User             @relation("StudentInvitations", fields: [studentId], references: [id], onDelete: Cascade)
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@unique([studentId, groupId])
  @@index([studentId])
  @@index([groupId])
}

model Meeting {
  id              String          @id @default(cuid())
  hostId          String
  title           String
  description     String?
  livekitRoomName String?
  livekitRoomSid  String?
  joinToken       String?
  status          MeetingStatus   @default(SCHEDULED)
  platform        MeetingPlatform @default(NEUROMEET)
  scheduledAt     DateTime?
  durationMinutes Int?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime        @default(now())
  updated_at      DateTime        @updatedAt @default(now())

  // New Fields
  timezone        String        @default("UTC")
  roomCode        String?       @unique
  isInstant       Boolean       @default(false)
  isGroupLocked   Boolean       @default(false)
  passcode        String?
  emailSent       Boolean       @default(false)
  
  // Relations
  host         User                 @relation("MeetingHost", fields: [hostId], references: [id])
  participants MeetingParticipant[]
  materials    MeetingMaterial[]
  
  // New Group Relations
  groupId       String?
  group         Group?        @relation(fields: [groupId], references: [id])
  room          Room?
  recordings    Recording[]

  @@index([hostId])
  @@index([status])
  @@index([scheduledAt])
  @@index([status, hostId])
  @@index([groupId])
  @@index([roomCode])
}

model MeetingParticipant {
  id                 String          @id @default(cuid())
  meetingId          String
  userId             String
  role               ParticipantRole @default(PARTICIPANT)
  consentGiven       Boolean         @default(false)
  joinedAt           DateTime?
  leftAt             DateTime?
  secondsPresent     Int             @default(0)
  avgEngagementScore Float?
  adhdFlagged        Boolean         @default(false)
  
  // Relations
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}

model MeetingMaterial {
  id           String   @id @default(cuid())
  meetingId    String
  uploadedBy   String
  driveFileId  String?
  driveViewUrl String?
  fileName     String
  mimeType     String?
  sizeBytes    Int?
  uploadedAt   DateTime @default(now())
  
  // Relations
  meeting  Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  
  @@index([meetingId])
}

model Room {
  id              String    @id @default(cuid())
  livekitRoomName String    @unique
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  meetingId       String    @unique
  meeting         Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model Recording {
  id               String          @id @default(cuid())
  status           RecordingStatus @default(PROCESSING)
  r2Key            String?
  driveFileId      String?         @unique
  fileName         String
  driveWebViewLink String?
  duration         Int?
  sizeBytes        Float?
  uploadedAt       DateTime        @default(now())
  meetingId        String?         @unique
  meeting          Meeting?        @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  
  @@index([meetingId])
  @@index([status])
}

model Notification {
  id         String    @id @default(cuid())
  type       NotifType
  title      String
  body       String
  actionUrl  String?
  read       Boolean   @default(false)
  metadata   Json?
  created_at DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, read])
  @@index([userId, created_at])
}