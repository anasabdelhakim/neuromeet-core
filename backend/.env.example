# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NESTJS_URL=http://localhost:4000

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL — credentials must match your docker-compose.yml
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/neuromeet_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave blank if Redis has no auth (local dev)
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong random secrets: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must include: http://localhost:4000/api/v1/oauth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/oauth/google/callback

# ─── Google Drive API ─────────────────────────────────────────────────────────

# OAuth Playground refresh token: https://developers.google.com/oauthplayground
# Scope required: https://www.googleapis.com/auth/drive.file
GOOGLE_REFRESH_TOKEN=your_google_drive_refresh_token
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
# The Google Drive folder ID where recordings & materials will be uploaded
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# ─── LiveKit ──────────────────────────────────────────────────────────────────
# Get credentials from: https://cloud.livekit.io → Project → Settings → API Keys
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
# e.g. wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_URL=wss://your-project.livekit.cloud

# ─── Resend (Transactional Email) ─────────────────────────────────────────────
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# ─── NeuroMeet AI Bot Worker ──────────────────────────────────────────────────
# Single worker (default):
AI_WORKER_URL=http://ai-worker:8080
# Multi-worker pool (comma-separated — for horizontal scaling):
# AI_WORKER_URLS=http://ai-worker-1:8080,http://ai-worker-2:8080
# Max concurrent rooms per worker instance:
AI_WORKER_MAX_LOAD=15
