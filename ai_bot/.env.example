# ─── LiveKit ──────────────────────────────────────────────────────────────────
# WebSocket URL of your LiveKit server (same as backend)
LIVEKIT_URL=wss://your-project.livekit.cloud

# ─── AI Model ─────────────────────────────────────────────────────────────────
# Absolute path to the PyTorch / ONNX model checkpoint inside the container
# In docker-compose.yml this is mounted as: ./ai_bot/models:/models:ro
MODEL_PATH=/models/best_model.pth
